<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground"
    tools:context=".DiagnosisSelectionActivity">

    <!-- Capa de Carga Global -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accentPinkButton"/>
    </FrameLayout>

    <ScrollView
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingHorizontal="32dp"
            android:paddingTop="64dp"
            android:paddingBottom="16dp">

            <!-- Icono Grande (Representación formal de salud/diagnóstico) -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="⚕️"
                android:textSize="64sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Título Principal MEJORADO -->
            <TextView
                android:id="@+id/textViewDiagnosisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración de tu Perfil de Salud"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primaryText"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textViewInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hemos detectado que tu app se enfocará en el manejo de la Diabetes. Por favor, confirma para optimizar tu experiencia."
                android:textSize="16sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="40dp"
                android:textAlignment="center"/>

            <!-- Panel de DETALLES DE DIABETES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiabetes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/dividerColor"
                app:cardBackgroundColor="@color/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIAGNÓSTICO PRINCIPAL"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diabetes"
                        android:textColor="@color/primaryText"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/dividerColor"/>

                    <!-- Beneficios de la configuración -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView style="@style/IconListItem"
                            android:text="📈 Gráficas de glucosa personalizadas."/>

                        <TextView style="@style/IconListItem"
                            android:text="💊 Recordatorios de medicación avanzados."/>

                        <TextView style="@style/IconListItem"
                            android:text="📋 Registro de comidas optimizado para carbohidratos."/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Contenedor para el botón anclado al fondo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="48dp"
        android:background="@color/cardBackground"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Botón de Confirmación anclado al fondo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSelection"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Confirmar y Empezar Seguimiento"
            android:textColor="@color/textOnPrimaryColor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accentPinkButton"
            app:cornerRadius="16dp"
            app:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

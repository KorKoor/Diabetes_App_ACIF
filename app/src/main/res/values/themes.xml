<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Diabetes_App" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#3A5A80</item>
        <item name="colorPrimaryVariant">#27456B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#D1E2F3</item>
        <item name="colorOnSecondary">#3A5A80</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="CustomTimePickerDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/accentGreenButton</item>
        <item name="colorPrimary">@color/buttonPrimaryBackground</item>
        <item name="android:textColorPrimary">@color/primaryText</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:windowBackground">@color/cardBackground</item>
        <item name="android:timePickerStyle">@style/CustomTimePickerStyle</item>
    </style>

    <style name="CustomTimePickerStyle" parent="android:Widget.Material.Light.TimePicker">
        <item name="android:numbersTextColor">@color/primaryText</item>
        <item name="android:headerBackground">@color/headerBackground</item>
    </style>

</resources>